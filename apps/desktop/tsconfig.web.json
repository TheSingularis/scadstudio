{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "react", "react-dom"],
    "outDir": "../../.tsbuild/desktop-web"
  },
  "include": ["src/renderer/src/**/*", "src/preload/index.d.ts"]
}
