{
  "name": "@scadstudio/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Visual CAD editor that reads and writes real OpenSCAD source",
  "author": "scadstudio",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --build tsconfig.json",
    "package:linux": "electron-vite build && electron-builder --linux AppImage --publish never",
    "package:win": "electron-vite build && electron-builder --win portable --publish never",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "test:corpus": "vitest run test/corpus",
    "corpus:fetch": "node test/corpus/fetch-corpus.mjs",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:nobuild": "playwright test"
  },
  "dependencies": {
    "@holistic-stack/tree-sitter-openscad": "^0.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "monaco-editor": "^0.56.0",
    "openscad-wasm": "^0.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "web-tree-sitter": "0.25.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.11.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
